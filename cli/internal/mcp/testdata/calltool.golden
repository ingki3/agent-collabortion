ent\": {\n        \"id\": \"55555555-5555-4555-8555-555555555555\",\n        \"name\": \"Reviewer\",\n        \"role\": \"reviewer\",\n        \"role_description\": \"checks\"\n      },\n      \"id\": \"p-3\",\n      \"kind\": \"agent\",\n      \"room_id\": \"33333333-3333-4333-8333-333333333333\",\n      \"room_role\": \"member\",\n      \"status\": \"idle\"\n    }\n  ]\n}","type":"text"}],"structuredContent":{"room":{"autonomy":"guided","blocked_reason":null,"description":"경쟁사 조사 방","id":"33333333-3333-4333-8333-333333333333","isolation":{"kind":"worktree","repo_path":"/repo"},"my_room_role":null,"name":"Market research","runtime_id":null,"status":"active","unread_count":0,"visibility":"workspace","workspace_id":"77777777-7777-4777-8777-777777777777"},"work":{"acceptance_criteria":["table of 3","sources cited"],"completion_progress":{"conditions":[],"human_gate":true,"met":1,"satisfied":false,"total":2},"director":{"display_name":"Dana","id":"88888888-8888-4888-8888-888888888888"},"director_user_id":"88888888-8888-4888-8888-888888888888","goal":"Find 3 competitors","id":"dddddddd-dddd-4ddd-8ddd-dddddddddddd","my_work_role":"member","room_id":"33333333-3333-4333-8333-333333333333","status":"active","title":"Competitors"},"participants":[{"id":"p-1","kind":"user","room_id":"33333333-3333-4333-8333-333333333333","room_role":"owner","user":{"display_name":"Dana","id":"88888888-8888-4888-8888-888888888888"}},{"agent":{"id":"44444444-4444-4444-8444-444444444444","name":"Researcher","role":"researcher","role_description":"digs"},"id":"p-2","kind":"agent","room_id":"33333333-3333-4333-8333-333333333333","room_role":"member","status":"working"},{"agent":{"id":"55555555-5555-4555-8555-555555555555","name":"Reviewer","role":"reviewer","role_description":"checks"},"id":"p-3","kind":"agent","room_id":"33333333-3333-4333-8333-333333333333","room_role":"member","status":"idle"}]}}}
